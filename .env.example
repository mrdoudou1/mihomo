# mihomo 全局环境配置文件
# 使用方法: source /opt/mihomo/.env
# 或由启动脚本自动加载

# ==================== 订阅配置 ====================
# 订阅地址（Clash 格式），支持多个用逗号分隔
SUBSCRIBE_URLS="https://example.com/your-subscription-url"
# 可选订阅名称，与地址按位置对应，用逗号分隔；留空显示“订阅 1、订阅 2”
# 示例：SUBSCRIBE_NAMES="机场 A,机场 B"
SUBSCRIBE_NAMES=""

# ==================== Web 控制面板 ====================
# 访问密码（必填，请修改默认值）
WEB_SECRET="CHANGE_ME_WEB_SECRET"

# Web 面板端口
UI_PORT=9999

# 允许访问 Web 面板的 IP 列表（CIDR 格式，用逗号分隔）
# 示例: "127.0.0.1,192.168.1.0/24,172.17.0.0/16"
ALLOWED_IPS="0.0.0.0"

# ==================== 代理端口 ====================
# HTTP 代理端口
HTTP_PORT=7890

# SOCKS5 代理端口
SOCKS_PORT=7891

# 允许使用代理的 IP 列表（CIDR 格式）
# 留空表示允许所有 IP（配合 allow-lan: true）
ALLOWED_PROXY_IPS=""

# ==================== 代理认证 ====================
# HTTP / SOCKS5 代理认证（留空表示不启用认证）
PROXY_USERNAME="CHANGE_ME_USERNAME"
PROXY_PASSWORD="CHANGE_ME_PROXY_PASSWORD"

# ==================== 网络配置 ====================
# 允许局域网连接（true/false）
ALLOW_LAN=true

# 绑定地址（* 表示所有接口，也可以指定具体 IP）
BIND_ADDRESS="*"

# IPv6 支持
IPV6=false

# 运行模式（rule/global/direct）rule=规则，global=全球，direct=直连
MODE=global

# 日志级别（debug/info/warning/error/silent）
LOG_LEVEL=info

# ==================== 高级配置 ====================
# 外部控制 API 绑定地址（通常与 UI 端口一致）
EXTERNAL_CONTROLLER="0.0.0.0:${UI_PORT}"

# 配置文件目录
CONFIG_DIR="/opt/mihomo/config"

# 订阅缓存文件路径
SUBSCRIBE_CACHE_PATH="./mysub.yaml"

# 订阅更新间隔（秒）
SUBSCRIBE_INTERVAL=3600

# 健康检查地址
HEALTH_CHECK_URL="http://www.gstatic.com/generate_204"

# 健康检查间隔（秒）0是不自动更新
HEALTH_CHECK_INTERVAL=300
